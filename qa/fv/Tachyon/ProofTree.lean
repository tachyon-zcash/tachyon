import Tachyon.Merge
import Tachyon.Unmerge

/-!
# The stamp proof tree

Two header kinds share one data shape. `Actions` carries proven action content with no fee in its
lineage. `Stamp` carries fee-bearing content and is the kind consensus verifies. `ActionsDerivable`
and `StampDerivable` are the headers an idealized PCD verifier accepts at each kind: every accepted
header is the output of a registered step on accepted inputs, which idealizes PCD knowledge
soundness.

`IsFee` is the fee-digest domain, separate from the action-digest domain. `R e d` is the tachygram
multiset digest `d` derives at epoch `e`: a spend's nullifier pair, an output's `cm` and pad, or a
fee's change commitment.

`FeeFuse` is the only step from `Actions` to `Stamp`. It multiplies in exactly one fee leaf over
non-empty fee-free content (`ActionsDerivable.feeFuse_leaves`). `StampUnmerge` can divide that fee
leaf out again (`unmerge_strips_fee`), so the fee in a published stamp rests on consensus coverage,
which always includes the bundle's own fee descriptor.

Each lift stands in for the span argument, under which a chain-node `anchor_end` pins every span
member to its epoch.
-/

namespace Tachyon

variable {F A E : Type*} [Field F]

/-- `Actions` headers: `OutputAction` and `SpendAction` leaves, `ActionMerge` and `ActionLift`. -/
inductive ActionsDerivable (IsFee : F → Prop) (epoch : A → E) (R : E → F → Multiset F) :
    Stamp F A → Prop
  | action (d : F) (a : A) :
      ¬ IsFee d → ActionsDerivable IsFee epoch R ⟨setPoly {d}, setPoly (R (epoch a) d), a⟩
  | merge {left right merged : Stamp F A} :
      ActionsDerivable IsFee epoch R left → ActionsDerivable IsFee epoch R right →
        Merge left right merged → ActionsDerivable IsFee epoch R merged
  | lift {s : Stamp F A} (a : A) :
      ActionsDerivable IsFee epoch R s → epoch a = epoch s.anchor →
        ActionsDerivable IsFee epoch R { s with anchor := a }

/-- `Stamp` headers: `FeeFuse` from `Actions`, `FeeSeed`, `StampMerge`, `StampUnmerge` and
`StampLift`. -/
inductive StampDerivable (IsFee : F → Prop) (epoch : A → E) (R : E → F → Multiset F) :
    Stamp F A → Prop
  | feeFuse {left : Stamp F A} (f : F) :
      ActionsDerivable IsFee epoch R left → IsFee f →
        StampDerivable IsFee epoch R
          ⟨left.actions * setPoly {f}, left.tachygrams * setPoly (R (epoch left.anchor) f),
            left.anchor⟩
  | feeSeed (f : F) (a : A) :
      IsFee f → StampDerivable IsFee epoch R ⟨setPoly {f}, setPoly (R (epoch a) f), a⟩
  | merge {left right merged : Stamp F A} :
      StampDerivable IsFee epoch R left → StampDerivable IsFee epoch R right →
        Merge left right merged → StampDerivable IsFee epoch R merged
  | unmerge {dividend divisor quotient : Stamp F A} :
      StampDerivable IsFee epoch R dividend → StampDerivable IsFee epoch R divisor →
        Unmerge dividend divisor quotient → StampDerivable IsFee epoch R quotient
  | lift {s : Stamp F A} (a : A) :
      StampDerivable IsFee epoch R s → epoch a = epoch s.anchor →
        StampDerivable IsFee epoch R { s with anchor := a }

variable {IsFee : F → Prop} {epoch : A → E} {R : E → F → Multiset F}

/-- Multiplying in one leaf `f` adds `f` to the generating digests. -/
theorem GeneratedBy.fuse {R : F → Multiset F} {D : Multiset F} {s : Stamp F A} (f : F) (a : A)
    (h : GeneratedBy R D s) :
    GeneratedBy R (D + {f}) ⟨s.actions * setPoly {f}, s.tachygrams * setPoly (R f), a⟩ :=
  ⟨by rw [h.1, setPoly_add], by rw [h.2, Multiset.add_bind, Multiset.singleton_bind, setPoly_add]⟩

/-- Every `Actions` header is generated by a non-empty multiset of action digests. -/
theorem ActionsDerivable.leafGenerated {s : Stamp F A} (h : ActionsDerivable IsFee epoch R s) :
    ∃ D, D ≠ 0 ∧ (∀ d ∈ D, ¬ IsFee d) ∧ GeneratedBy (R (epoch s.anchor)) D s := by
  induction h with
  | action d a hd =>
      exact ⟨{d}, Multiset.singleton_ne_zero d, by simpa using hd, rfl,
        by rw [Multiset.singleton_bind]⟩
  | merge _ _ hm ihl ihr =>
      obtain ⟨DL, hDL, hDLfee, hl⟩ := ihl
      obtain ⟨DR, -, hDRfee, hr⟩ := ihr
      rw [← hm.anchor] at hr
      rw [hm.merged_anchor]
      refine ⟨DL + DR, by simp [hDL], fun d hd => ?_, hm.generatedBy hl hr⟩
      exact (Multiset.mem_add.mp hd).elim (hDLfee d) (hDRfee d)
  | lift a _ hepoch ih =>
      obtain ⟨D, hD, hDfee, hs⟩ := ih
      exact ⟨D, hD, hDfee, by rw [hepoch]; exact hs⟩

/-- `FeeFuse` outputs a stamp whose leaves are exactly one fee digest over non-empty fee-free action
content. -/
theorem ActionsDerivable.feeFuse_leaves [DecidablePred IsFee] {left : Stamp F A}
    (h : ActionsDerivable IsFee epoch R left) {f : F} (hf : IsFee f) :
    ∃ D, D.filter IsFee = {f} ∧ D.filter (¬ IsFee ·) ≠ 0 ∧
      GeneratedBy (R (epoch left.anchor)) D
        ⟨left.actions * setPoly {f}, left.tachygrams * setPoly (R (epoch left.anchor) f),
          left.anchor⟩ := by
  obtain ⟨D, hD, hDfee, hs⟩ := h.leafGenerated
  refine ⟨D + {f}, ?_, ?_, hs.fuse f left.anchor⟩
  · rw [Multiset.filter_add, Multiset.filter_eq_nil.mpr hDfee, Multiset.filter_singleton,
      if_pos hf, zero_add]
  · rwa [Multiset.filter_add, Multiset.filter_eq_self.mpr hDfee, Multiset.filter_singleton,
      if_neg (not_not.mpr hf), Multiset.empty_eq_zero, add_zero]

/-- Every `Stamp` header is leaf-generated at its anchor's epoch. -/
theorem StampDerivable.leafGenerated [DecidableEq F] {s : Stamp F A}
    (h : StampDerivable IsFee epoch R s) : ∃ D, GeneratedBy (R (epoch s.anchor)) D s := by
  induction h with
  | feeFuse f hleft _ =>
      obtain ⟨D, -, -, hs⟩ := hleft.leafGenerated
      exact ⟨D + {f}, hs.fuse f _⟩
  | feeSeed f a _ => exact ⟨{f}, rfl, by rw [Multiset.singleton_bind]⟩
  | merge _ _ hm ihl ihr =>
      obtain ⟨DL, hl⟩ := ihl
      obtain ⟨DR, hr⟩ := ihr
      rw [← hm.anchor] at hr
      rw [hm.merged_anchor]
      exact ⟨DL + DR, hm.generatedBy hl hr⟩
  | unmerge _ _ hu ihdividend ihdivisor =>
      obtain ⟨D, hdividend⟩ := ihdividend
      obtain ⟨D', hdivisor⟩ := ihdivisor
      rw [← hu.anchor] at hdivisor
      rw [hu.quotient_anchor]
      exact ⟨D - D', hu.generatedBy hdividend hdivisor⟩
  | lift a _ hepoch ih =>
      obtain ⟨D, hs⟩ := ih
      exact ⟨D, by rw [hepoch]; exact hs⟩

/-- Consensus rebuilds the action set from a bundle's covered descriptors and verifies the stamp
against it. A derivable stamp that passes publishes exactly the covered leaves' tachygrams. -/
theorem StampDerivable.published [DecidableEq F] {s : Stamp F A}
    (h : StampDerivable IsFee epoch R s) {covered : Multiset F}
    (hcovered : s.actions = setPoly covered) :
    s.tachygrams = setPoly (covered.bind (R (epoch s.anchor))) := by
  obtain ⟨D, hD, hT⟩ := h.leafGenerated
  rw [hT, setPoly_injective (hD.symm.trans hcovered)]

/-- `StampUnmerge` can divide a fee leaf out. From action digests `d₁`, `d₂` and a fee digest `f`
at one anchor, the fee-free stamp over `d₁` alone is derivable as
`FeeFuse(d₁ + d₂, f) / FeeFuse(d₂, f)`. -/
theorem unmerge_strips_fee {d₁ d₂ f : F} (a : A) (hd₁ : ¬ IsFee d₁) (hd₂ : ¬ IsFee d₂)
    (hf : IsFee f) :
    StampDerivable IsFee epoch R ⟨setPoly {d₁}, setPoly (R (epoch a) d₁), a⟩ := by
  have h₁ := ActionsDerivable.action (IsFee := IsFee) (epoch := epoch) (R := R) d₁ a hd₁
  have h₂ := ActionsDerivable.action (IsFee := IsFee) (epoch := epoch) (R := R) d₂ a hd₂
  have h₁₂ := ActionsDerivable.merge h₁ h₂
    (merged := ⟨setPoly {d₁} * setPoly {d₂}, setPoly (R (epoch a) d₁) * setPoly (R (epoch a) d₂),
      a⟩) ⟨rfl, rfl, rfl, rfl⟩
  refine StampDerivable.unmerge (StampDerivable.feeFuse f h₁₂ hf) (StampDerivable.feeFuse f h₂ hf)
    ⟨rfl, ?_, ?_, rfl⟩ <;> dsimp only <;> ring

end Tachyon
