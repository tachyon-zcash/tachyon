import Tachyon.ProofTree

/-!
# Removal closure

`StampUnmerge` needs a divisor stamp in hand, but the divisor need not be a sub-aggregate anyone
proved directly. At one anchor, the stamps generated by derivable leaf multisets are closed under
sum (`StampDerivable.merge_generated`) and under difference whenever the divisor's leaves are
contained in the dividend's (`StampDerivable.unmerge_generated`). Sub-aggregate boundaries therefore
do not bound removal: `unmerge_through_hidden` removes `B` from an opaque `A + B` by merging in `C`
and dividing by `B + C`.
-/

namespace Tachyon

variable {F A E : Type*} [Field F] {IsFee : F → Prop} {epoch : A → E}
  {R : E → F → Multiset F}

/-- The stamp generated by leaf digests `D` at anchor `a`. -/
noncomputable def generatedStamp (R : E → F → Multiset F) (epoch : A → E) (D : Multiset F) (a : A) :
    Stamp F A :=
  ⟨setPoly D, setPoly (D.bind (R (epoch a))), a⟩

/-- Derivable stamps generated by `D₁` and `D₂` at one anchor merge into the stamp generated by
`D₁ + D₂`. -/
theorem StampDerivable.merge_generated {D₁ D₂ : Multiset F} {a : A}
    (h₁ : StampDerivable IsFee epoch R (generatedStamp R epoch D₁ a))
    (h₂ : StampDerivable IsFee epoch R (generatedStamp R epoch D₂ a)) :
    StampDerivable IsFee epoch R (generatedStamp R epoch (D₁ + D₂) a) :=
  .merge h₁ h₂ ⟨rfl, by simp [generatedStamp, setPoly_add],
    by simp [generatedStamp, Multiset.add_bind, setPoly_add], rfl⟩

/-- Dividing the derivable stamp generated by `D₁` by the one generated by `D₂ ≤ D₁` at the same
anchor derives the stamp generated by `D₁ - D₂`. -/
theorem StampDerivable.unmerge_generated [DecidableEq F] {D₁ D₂ : Multiset F} {a : A} (hle : D₂ ≤ D₁)
    (h₁ : StampDerivable IsFee epoch R (generatedStamp R epoch D₁ a))
    (h₂ : StampDerivable IsFee epoch R (generatedStamp R epoch D₂ a)) :
    StampDerivable IsFee epoch R (generatedStamp R epoch (D₁ - D₂) a) :=
  .unmerge h₁ h₂ ⟨rfl,
    by simp only [generatedStamp]; rw [← setPoly_add, add_tsub_cancel_of_le hle],
    by simp only [generatedStamp]; rw [← setPoly_add, ← Multiset.add_bind, add_tsub_cancel_of_le hle],
    rfl⟩

/-- From derivable stamps over `A + B`, `C` and `B + C` at one anchor, the stamp over `A` alone is
derivable as `(A + B + C) / (B + C)`, though no stamp in hand isolates `A`. -/
theorem unmerge_through_hidden [DecidableEq F] {LA LB LC : Multiset F} {a : A}
    (hAB : StampDerivable IsFee epoch R (generatedStamp R epoch (LA + LB) a))
    (hC : StampDerivable IsFee epoch R (generatedStamp R epoch LC a))
    (hBC : StampDerivable IsFee epoch R (generatedStamp R epoch (LB + LC) a)) :
    StampDerivable IsFee epoch R (generatedStamp R epoch LA a) := by
  have hABC := hAB.merge_generated hC
  have hle : LB + LC ≤ LA + LB + LC := by
    rw [add_assoc]
    exact Multiset.le_add_left _ _
  have hquot := StampDerivable.unmerge_generated hle hABC hBC
  rwa [add_assoc, add_tsub_cancel_right] at hquot

end Tachyon
