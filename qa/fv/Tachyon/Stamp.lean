import Tachyon.SetPoly

/-!
# Idealized stamp headers

The Rust `Stamp` header data is `(stamp_tg_commit, anchor)`, where `stamp_tg_commit` is the bridge
hash of output slot O1. The proof carries exactly two output polynomials: O0 is the action set and
O1 is the tachygram set. `Actions` has only `anchor` as header data, with the same two slots.
This model's `Stamp` is the enriched semantic state of those slots and the anchor, not the encoded
Rust header. It replaces committed polynomials with their openings, idealizing commitment/bridge
binding, and reads `enforce_poly_product` at the framework's shared `zeta` as the polynomial
identity it pins, idealizing Schwartz-Zippel. Merge checks L0 * R0 = O0 and L1 * R1 = O1;
unmerge checks R0 * O0 = L0 and R1 * O1 = L1.

Leaf digests and tachygrams are both field elements. `R e d` is the tachygram multiset that a leaf
with digest `d` derives at epoch `e`: a spend's nullifier pair, an output's `cm` and pad, or a fee's
change commitment. Taking `R` as a function encodes the pairing assumption that two leaf proofs with
the same digest in one epoch derive the same tachygrams.
-/

namespace Tachyon

open Polynomial

/-- Semantic proof state: output slots O0/O1 followed by the header's anchor. -/
structure Stamp (F A : Type*) [Field F] where
  actions : F[X]
  tachygrams : F[X]
  anchor : A

variable {F A : Type*} [Field F]

/-- `s` is generated by the leaf digests `D` under the pairing `R`: the action set's roots are `D`,
and the tachygram set's roots are the sum over `D` of each digest's tachygrams. -/
def GeneratedBy (R : F → Multiset F) (D : Multiset F) (s : Stamp F A) : Prop :=
  s.actions = setPoly D ∧ s.tachygrams = setPoly (D.bind R)

/-- `StampMerge`: equal anchors, and each output column is the product of the input columns. -/
structure Merge (left right merged : Stamp F A) : Prop where
  anchor : left.anchor = right.anchor
  actions : merged.actions = left.actions * right.actions
  tachygrams : merged.tachygrams = left.tachygrams * right.tachygrams
  merged_anchor : merged.anchor = left.anchor

/-- `StampUnmerge`: equal anchors, and in each column the divisor times the witnessed quotient is
the dividend. Nothing ties the two columns together. -/
structure Unmerge (dividend divisor quotient : Stamp F A) : Prop where
  anchor : dividend.anchor = divisor.anchor
  actions : divisor.actions * quotient.actions = dividend.actions
  tachygrams : divisor.tachygrams * quotient.tachygrams = dividend.tachygrams
  quotient_anchor : quotient.anchor = dividend.anchor

end Tachyon
